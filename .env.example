# Copia este archivo a .env y completa tu API key.
# El MVP usa la API de OpenAI (Chat Completions) para el análisis real de documentos.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

PORT=8080

# Límite de la prueba gratuita: nº de análisis permitidos antes de pedir upgrade.
# Es una regla de negocio real (cuenta los análisis guardados en data/db.json),
# pensada como paso previo a integrar cobro real (Stripe u otro) más adelante.
FREE_TRIAL_LIMIT=5
