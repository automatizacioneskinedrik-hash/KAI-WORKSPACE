# Copia este archivo a .env y completa tu API key.
# El MVP usa la API de OpenAI (Chat Completions) para el análisis real de documentos.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

PORT=8080

# Créditos: cada cuenta recibe TRIAL_CREDITS solo si su IP aún no reclamó la prueba.
# Un análisis cuesta ANALYSIS_COST créditos (por defecto 1 análisis = 15 créditos).
TRIAL_CREDITS=15
ANALYSIS_COST=15

# Correos (separados por coma) con créditos ilimitados (rol admin).
ADMIN_EMAILS=

# Embeddings del RAG normativo (carpeta knowledge/).
OPENAI_EMBED_MODEL=text-embedding-3-small

# Pon 1 si el servidor está detrás de Cloud Run / un proxy, para leer la IP real (X-Forwarded-For).
TRUST_PROXY=0

# Token compartido para el panel de admin (system prompt). Genera uno propio:
# node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
# Placeholder temporal hasta que exista autenticación real de administrador.
ADMIN_TOKEN=changeme
