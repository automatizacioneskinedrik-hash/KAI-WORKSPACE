    "multer": "^2.0.1",
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.6",
    "concurrently": "^10.0.5",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
