{
  "name": "kai-workspace",
  "version": "0.1.0",
  "description": "K·AI Workspace — MVP: AI Technical Reviewer para documentación BIM/AEC (ISO 19650)",
  "type": "commonjs",
  "main": "server/index.js",
"scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
